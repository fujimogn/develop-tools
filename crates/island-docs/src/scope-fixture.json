{
  "version": 1,
  "byteLimits": [
    { "scope": "all", "path": "AGENTS.md", "maxBytes": "AGENTS_MAX_BYTES" },
    { "scope": "all", "path": "CLAUDE.md", "maxBytes": "CLAUDE_MAX_BYTES" },
    { "scope": "all", "path": "CONTEXT.md", "maxBytes": "CONTEXT_MAX_BYTES" },
    { "scope": "all", "path": "TODO.md", "maxBytes": "TODO_MAX_BYTES" },
    { "scope": "all", "path": "CHANGELOG.md", "maxBytes": "CHANGELOG_MAX_BYTES" },
    { "scope": "example/home", "path": "home/AGENTS.md", "maxBytes": "AGENTS_MAX_BYTES" },
    { "scope": "example/home", "path": "home/CLAUDE.md", "maxBytes": "CLAUDE_MAX_BYTES" },
    { "scope": "example/home", "path": "home/.agents/AGENTS.md", "maxBytes": 28000 },
    { "scope": "example/home", "path": "README.md", "maxBytes": 16000 }
  ],
  "linkSourceExclusions": [
    { "scope": "all", "prefix": "openspec/changes/archive/" },
    { "scope": "all", "prefix": ".claude/skills/" },
    { "scope": "example/home", "prefix": "Documents/" },
    { "scope": "example/primary", "prefix": "docs/references/primary-sources/" },
    { "scope": "example/site", "prefix": "docs/references/upstream/" }
  ],
  "hostPathLinkAllowScopes": ["example/home"],
  "indexRecordDirs": [
    { "scope": "all", "dirs": ["reviews", "review", "plans", "research", "experiments", "archive"] }
  ],
  "indexRequirements": [
    {
      "scope": "example/site",
      "path": "docs/conventions/site-production-workflow.md",
      "indexes": ["docs/README.md", "docs/conventions/README.md"]
    },
    {
      "scope": "example/site",
      "path": "docs/design/site-page-plan.md",
      "indexes": ["docs/README.md", "docs/design/README.md"]
    },
    {
      "scope": "example/site",
      "path": "docs/design/animation-stack-plan.md",
      "indexes": ["docs/README.md", "docs/design/README.md"]
    },
    {
      "scope": "example/site",
      "path": "docs/adr/0016-site-production-adr-tdd-workflow.md",
      "indexes": ["docs/adr/README.md"]
    },
    {
      "scope": "example/site",
      "path": "docs/adr/0017-animation-stack.md",
      "indexes": ["docs/adr/README.md"]
    }
  ],
  "docsLayouts": [
    {
      "scope": "example/home",
      "allowedDirs": ["setup", "operations", "guides", "reference", "adr"]
    }
  ],
  "retiredHistorical": [{ "scope": "example/meta", "prefix": "docs/old-improvements.md" }],
  "retiredExtraSources": [{ "scope": "example/meta", "prefix": ".claude/skills/" }]
}
